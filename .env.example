NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:4001
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=false
DATABASE_URL=postgres://imageunit:imageunit@localhost:5440/imageunit
REDIS_URL=redis://localhost:6390
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=imageunit-media
