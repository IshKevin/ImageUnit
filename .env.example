# Local configuration. `cp .env.example .env`. For production use `make prod-env DOMAIN=...` (see docs/RUNBOOK.md).
# Read by docker compose (interpolation + container env) and by host-side tools (tests, `npm run dev:*`).
COMPOSE_PROJECT_NAME=imageunit
NODE_ENV=development
LOG_LEVEL=info

# ---- Public URLs (what browsers and other websites use) ----
PUBLIC_WEB_URL=http://localhost:4001
API_PUBLIC_URL=http://localhost:4000
S3_PUBLIC_ENDPOINT=http://localhost:8333
COOKIE_SECURE=false
# Which websites' browsers may call the API and load images from storage. Empty = only the web app.
# `*` = any website (no cookies are ever shared with other sites); or a comma-separated list: https://a.com,https://b.com
CORS_ORIGINS=
# CSRF protection for cookie sessions: host (default, needs no config) | strict (only PUBLIC_WEB_URL) | off
ORIGIN_CHECK=
TRUST_PROXY=false

# ---- Secrets (change all of these in production; `make prod-env` generates them) ----
SESSION_SECRET=change-me-to-64-random-hex-chars-change-me-to-64-random-hex-chars
POSTGRES_PASSWORD=imageunit
REDIS_PASSWORD=imageunit
S3_ACCESS_KEY=imageunit
S3_SECRET_KEY=imageunit-secret
LOGIN_RATE_LIMIT=1000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# ---- Application ----
PORT=4000
S3_BUCKET=imageunit-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_TOTAL_BYTES=10995116502016
MAX_UPLOAD_BYTES=104857600

# ---- Host-side development only (running `npm run dev:api` etc. outside Docker). Containers ignore these. ----
DATABASE_URL=postgres://imageunit:imageunit@localhost:5440/imageunit
REDIS_URL=redis://:imageunit@localhost:6390
S3_ENDPOINT=http://localhost:8333

BOOTSTRAP_ADMIN_EMAIL=admin@afs.org
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345