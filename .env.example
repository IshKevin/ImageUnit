S3_PUBLIC_ENDPOINT=http://localhost:9100
SESSION_SECRET=change-me-to-64-random-hex-chars-change-me-to-64-random-hex-chars
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345
STORAGE_TOTAL_BYTES=10995116502016
COMPOSE_PROJECT_NAME=imageunit
