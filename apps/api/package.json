{
  "name": "@imageunit/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "start:worker": "node --env-file=../../.env dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.10",
    "drizzle-orm": "^0.45.3",
    "exifr": "^7.1.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
